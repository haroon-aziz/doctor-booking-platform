# ---------------------------------------------------------------------------
# Core
# ---------------------------------------------------------------------------
NODE_ENV=development
APP_NAME="Doctor Booking Platform"
APP_URL=http://localhost:3000
PORT=3000

# ---------------------------------------------------------------------------
# Database (must match docker-compose.yml)
# ---------------------------------------------------------------------------
POSTGRES_USER=dbp
POSTGRES_PASSWORD=dbp_local_password
POSTGRES_DB=doctor_booking
POSTGRES_PORT=5432
DATABASE_URL="postgresql://dbp:dbp_local_password@localhost:5432/doctor_booking?schema=public&connection_limit=10"

# ---------------------------------------------------------------------------
# Redis — used for slot locking, rate limiting and caching
# ---------------------------------------------------------------------------
REDIS_PORT=6379
REDIS_URL="redis://localhost:6379"

# ---------------------------------------------------------------------------
# Meilisearch
# ---------------------------------------------------------------------------
# search  -> meilisearch | postgres
# Postgres is exact-match only. The meilisearch driver adds typo tolerance and
# falls back to Postgres automatically if the index is unreachable or empty.
SEARCH_DRIVER=meilisearch
MEILISEARCH_PORT=7700
MEILISEARCH_HOST="http://localhost:7700"
MEILISEARCH_MASTER_KEY=dbp_local_master_key_change_me

# ---------------------------------------------------------------------------
# Auth — generate with: openssl rand -base64 32
# ---------------------------------------------------------------------------
BETTER_AUTH_SECRET=replace_me_with_a_32_byte_random_string
BETTER_AUTH_URL=http://localhost:3000
SESSION_MAX_AGE_SECONDS=604800
SESSION_UPDATE_AGE_SECONDS=86400

# ---------------------------------------------------------------------------
# Adapter selection. Every adapter defaults to its offline "mock" driver so the
# platform runs with zero third-party accounts. Swap the driver and fill in the
# matching credentials to activate a production provider.
# ---------------------------------------------------------------------------

# email   -> mock | smtp
EMAIL_DRIVER=mock
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM="no-reply@localhost"

# sms     -> mock | twilio
SMS_DRIVER=mock
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# payment -> mock | stripe | jazzcash | easypaisa | paypal
PAYMENT_DRIVER=mock
PAYMENT_CURRENCY=PKR
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
JAZZCASH_MERCHANT_ID=
JAZZCASH_PASSWORD=
JAZZCASH_INTEGRITY_SALT=
EASYPAISA_STORE_ID=
EASYPAISA_ACCOUNT_NUMBER=
EASYPAISA_HASH_KEY=
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# video   -> mock | daily | zoom | meet
VIDEO_DRIVER=mock
DAILY_API_KEY=
ZOOM_ACCOUNT_ID=
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=
GOOGLE_MEET_CLIENT_ID=
GOOGLE_MEET_CLIENT_SECRET=

# storage -> local | s3
STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=./storage/uploads
STORAGE_MAX_FILE_SIZE_BYTES=10485760
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# ---------------------------------------------------------------------------
# AI assistant — Ollama runs locally; falls back to a deterministic rule engine
# when unreachable so the assistant never hard-fails.
# ---------------------------------------------------------------------------
AI_DRIVER=ollama
OLLAMA_PORT=11434
OLLAMA_HOST="http://localhost:11434"
OLLAMA_MODEL=llama3.2
OLLAMA_TIMEOUT_MS=30000

# ---------------------------------------------------------------------------
# Booking engine
# ---------------------------------------------------------------------------
SLOT_HOLD_TTL_SECONDS=600
BOOKING_DEFAULT_TIMEZONE=Asia/Karachi
BOOKING_MAX_ADVANCE_DAYS=90
BOOKING_MIN_LEAD_MINUTES=60

# ---------------------------------------------------------------------------
# Rate limiting
# ---------------------------------------------------------------------------
RATE_LIMIT_AUTH_MAX=10
RATE_LIMIT_AUTH_WINDOW_SECONDS=900
RATE_LIMIT_API_MAX=120
RATE_LIMIT_API_WINDOW_SECONDS=60

# ---------------------------------------------------------------------------
# Logging -> fatal | error | warn | info | debug | trace
# ---------------------------------------------------------------------------
LOG_LEVEL=info

# Serve the marketplace from the in-memory demo repository (design review only).
DEMO_MODE=false
